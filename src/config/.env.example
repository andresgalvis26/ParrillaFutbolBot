# Configuración del Bot de Telegram
BOT_TOKEN=tu_bot_token_aqui
CHAT_ID=tu_chat_id_aqui

# Configuración para producción (opcional)
WEBHOOK_URL=https://tu-dominio.com
FLASK_PORT=10000
DEBUG=False

# Fuente de datos para los partidos (opcional)
# Opciones: 'futbolred' | 'partidos-de-hoy'
# - futbolred: Scraper de futbolred.com (usa curl_cffi para bypass de Akamai CDN)
# - partidos-de-hoy: Scraper de partidos-de-hoy.co (default, más estable)
SCRAPER_SOURCE=partidos-de-hoy

# Configuración adicional (opcional)
LOG_LEVEL=INFO
